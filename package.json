    "express": "^4.18.1",
    "express-validator": "^6.14.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^6.3.2",
    "morgan": "^1.10.0",
    "pdfkit": "^0.13.0",
    "swagger-ui-express": "^4.4.0",
    "voilab-pdf-table": "^0.5.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.12",
